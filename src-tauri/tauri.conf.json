{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOSICKWHILE",
  "version": "0.5.1",
  "identifier": "com.mosickwhile.desktop",
  "build": {
    "beforeDevCommand": "npm run build:bridge && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bridge && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MOSICKWHILE",
        "width": 372,
        "height": 640,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "center": true

      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "mosickwhile_bridge.dll",
      "resources/seeta_fd_frontal_v1.0.bin"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
